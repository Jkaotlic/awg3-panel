[Unit]
Description=awg3-panel — выпуск клиентских конфигов AmneziaWG 3.x
Documentation=https://github.com/Jkaotlic/awg3-panel
# Только сеть: панель обслуживает набор интерфейсов из config.yaml, и
# привязка к одному конкретному юниту (раньше — awg3.service, снесённому
# 07.09.2026) была бы ложью. Опущенное устройство панель показывает как
# ошибку по этому интерфейсу, а не падает.
After=network-online.target
Wants=network-online.target
# Ни PartOf=, ни BindsTo= сознательно нет: панель не управляет туннелем,
# и её падение или перезапуск не должны затрагивать awg3.service.

[Service]
Type=simple
# root нужен для сокета AmneziaWG и конфига с правами 600.
User=root
Environment=AWG3PANEL_SYSTEMD=1
ExecStart=/usr/local/bin/awg3panel -config /etc/awg3panel/config.yaml serve
Restart=on-failure
RestartSec=5s
# Бюджет systemd рассчитан на shutdownTimeout до 120s.
# Оставляем systemd ещё 30s до принудительного завершения.
TimeoutStopSec=150s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK нужен для чтения назначенных адресов при старте.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/etc/amnezia/amneziawg /var/lib/awg3panel
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
