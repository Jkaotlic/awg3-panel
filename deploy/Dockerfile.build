FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools python3 ca-certificates curl make && rm -rf /var/lib/apt/lists/*
RUN ln -s /usr/include/linux /usr/include/x86_64-linux-musl/linux && \
    ln -s /usr/include/asm-generic /usr/include/x86_64-linux-musl/asm-generic && \
    ln -s /usr/include/x86_64-linux-gnu/asm /usr/include/x86_64-linux-musl/asm
WORKDIR /src
COPY . /src
ARG VERSION=dev
ENV VERSION=${VERSION}
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    go test ./... -count=1 && go test -tags readonly ./... -count=1 && \
    go vet ./... && go vet -tags readonly ./... && bash deploy/build-bundle.sh /out
FROM scratch AS artifact
COPY --from=0 /out/ /
