[Unit]
Description=Personal AmneziaWG 3.1 userspace interface
After=network-online.target
Wants=network-online.target
Before=awg3panel.service

[Service]
Type=simple
ExecStartPre=/usr/local/libexec/awg3panel/awgtop-runtime preflight
ExecStart=/opt/awgtop/bin/amneziawg-go -f awgtop
ExecStartPost=/usr/local/libexec/awg3panel/awgtop-runtime up
ExecStopPost=/usr/local/libexec/awg3panel/awgtop-runtime down
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
Environment=WG_COLOR_MODE=never
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
